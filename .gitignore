/target/
**/node_modules/
**/dist/
*.tsbuildinfo

# Tauri generated
/app/src-tauri/gen/

# Local state and secrets (never commit credentials or keys)
.env
.env.*
*.pem
*.key
id_*
known_hosts
*.stackdump

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generated sample data
/examples/*.sqlite

# Web site build output
/site/

# Native bundles and release builds
*.msi
*.exe
*.dmg
*.AppImage
*.deb
*.rpm
/app/src-tauri/target/

# Generated outputs
*.log
bash.exe.stackdump

# Web build inputs (copied in by scripts/build-site.sh)
/app/public/pkg/
/app/public/examples/

# Browser test output
/app/playwright-report/
/app/test-results/
